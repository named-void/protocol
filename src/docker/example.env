# Копируй в .env рядом с compose.yaml и правь под раскладку хоста (сервера);
# в git не коммитится.

# Каталог git-репозиториев на хосте: создаётся до запуска, клоны и
# синхронизацию (pull/push) выполняет хост.
REPOS_HOST_DIR=/srv/omp/repos

# Каталог подключаемых конфигов провайдеров подключения omp: создаётся до
# запуска, конфиги кладутся туда.
OMP_CONFIG_HOST_DIR=/srv/omp/omp-config

# uid:gid владельца файлов на хосте (Linux; на macOS virtiofs игнорирует значение).
HOST_UID=1000
HOST_GID=1000
